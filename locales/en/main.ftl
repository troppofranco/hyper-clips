audit-col-process = PID
audit-col-local = Local
audit-col-remote = Remote
audit-col-state = State
audit-connections-explain = Expected: the local pipe does not use the network; "listen" on 127.0.0.1 is the local API (if enabled); on 0.0.0.0 it is an active LAN share; api.github.com/github.com only while checking for or downloading an update.
audit-network-log = Outgoing request log
audit-network-log-empty = No requests logged.
audit-open = Open
audit-metadata = What the files contain
audit-metadata-text = Clips, recordings and exports (MP4/WebM/GIF/WebP) are written by Hyper Clips' own muxers without metadata: no program or encoder name, no user, zeroed creation date, no location. Screenshots carry no EXIF. The game name only appears in the file name and in the local index.
audit-erase = Delete data
erase-logs = Logs (including the network log)
erase-cache = Cache, temporary thumbnails and buffers
erase-library = Library index and thumbnails (clips are kept)
erase-settings = Settings, plugins and API token
erase-vault = Encrypted vault (irreversible)
